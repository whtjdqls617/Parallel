{
  "_comment": "moods: tired|lonely|hard|rest|okay|night|place|song|any. 원문 키워드로 골라짐.",
  "entries": [
    {
      "moods": ["tired"],
      "text": "오늘 좀 길었나 봐요. 몸부터 좀 풀어요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["tired"],
      "text": "그 피곤함, 글에 다 묻어 있네요. 쉬엄쉬엄 해요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["tired", "hard"],
      "text": "힘들었나 보다… 일단 여기 앉아 있어도 돼요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["lonely"],
      "text": "혼자인 밤 있잖아요. 저도 가끔 그래요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["lonely"],
      "text": "그 말 읽으니까, 옆자리가 좀 덜 빈 느낌이에요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["hard"],
      "text": "마음이 좀 무거웠나 봐요. 여기선 잠깐 내려놔도 돼요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["hard"],
      "text": "그런 날 있지요. 오늘만큼은 스스로한테 좀 관대해져요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["rest"],
      "text": "쉬고 있는 중이군요. 그거면 이미 잘한 거예요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["rest"],
      "text": "잠깐 앉아 있는 그 시간, 저도 좋아해요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["okay"],
      "text": "그 말, 괜히 마음이 놓이네요. 저도 읽었어요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["okay"],
      "text": "따뜻하게 남았네요. 여기까지 잘 왔어요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["night"],
      "text": "같은 밤인가 봐요. 저도 아직 안 잤어요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["night"],
      "text": "밤에 남긴 글이라 그런가, 더 가까이 느껴지네요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["place"],
      "text": "그 장면이 눈에 그려지네요. 잠시 같이 있을게요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["place"],
      "text": "거기 분위기, 글만 읽어도 좀 전해져요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["song"],
      "text": "그 노래 고른 거, 분위기랑 잘 맞네요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["song"],
      "text": "곡까지 남겨 둔 거 좋았어요. 귀에 남을 것 같아요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["any"],
      "text": "읽었어요. 남겨 준 말, 마음에 좀 남네요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["any"],
      "text": "그냥 지나다 봤는데, 괜히 고개가 끄덕여졌어요.",
      "song": "",
      "artist": ""
    },
    {
      "moods": ["any"],
      "text": "그 말 듣고 가려요. 오늘도 수고했어요.",
      "song": "",
      "artist": ""
    }
  ]
}
