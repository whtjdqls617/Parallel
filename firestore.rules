rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['theme', 'text', 'artist', 'song', 'createdAt', 'expiresAt', 'uid', 'replies'])
        && request.resource.data.theme in ['desert', 'forest', 'ocean', 'space']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 80
        && request.resource.data.artist is string
        && request.resource.data.artist.size() <= 40
        && request.resource.data.song is string
        && request.resource.data.song.size() <= 40
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(48, 'h')
        && request.resource.data.uid == request.auth.uid
        && (!('replies' in request.resource.data)
            || request.resource.data.replies == {});

      allow delete: if request.auth != null
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt <= request.time;

      function repliesAlive() {
        return resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['replies', 'replyText', 'replyUid', 'replyCreatedAt'])
          && request.resource.data.replies is map
          && request.resource.data.replies.keys().size() <= 12;
      }

      function validOwnReply() {
        return request.auth.uid in request.resource.data.replies
          && request.resource.data.replies[request.auth.uid].keys()
               .hasOnly(['text', 'createdAt', 'artist', 'song', 'x', 'y'])
          && request.resource.data.replies[request.auth.uid].text is string
          && request.resource.data.replies[request.auth.uid].text.size() > 0
          && request.resource.data.replies[request.auth.uid].text.size() <= 80
          && request.resource.data.replies[request.auth.uid].createdAt is timestamp
          && request.resource.data.replies[request.auth.uid].artist is string
          && request.resource.data.replies[request.auth.uid].artist.size() <= 40
          && request.resource.data.replies[request.auth.uid].song is string
          && request.resource.data.replies[request.auth.uid].song.size() <= 40
          && request.resource.data.replies[request.auth.uid].x is number
          && request.resource.data.replies[request.auth.uid].x >= 0
          && request.resource.data.replies[request.auth.uid].x <= 1
          && request.resource.data.replies[request.auth.uid].y is number
          && request.resource.data.replies[request.auth.uid].y >= 0
          && request.resource.data.replies[request.auth.uid].y <= 1;
      }

      function addingOwnReply() {
        return validOwnReply()
          && request.resource.data.replies.keys().size() > 0
          && !(request.auth.uid in resource.data.get('replies', {}))
          && request.resource.data.replies.keys()
               .hasAll(resource.data.get('replies', {}).keys())
          && request.resource.data.replies.keys().size()
               == resource.data.get('replies', {}).keys().size() + 1;
      }

      function legacyAddOwnReply() {
        return validOwnReply()
          && resource.data.get('replies', {}).keys().size() == 0
          && resource.data.get('replyText', '') is string
          && resource.data.replyText.size() > 0
          && resource.data.get('replyUid', '') is string
          && resource.data.replyUid.size() > 0
          && request.auth.uid != resource.data.replyUid
          && resource.data.replyUid in request.resource.data.replies
          && request.resource.data.replies.keys().size() == 2;
      }

      function editingOwnReply() {
        return validOwnReply()
          && request.auth.uid in resource.data.get('replies', {})
          && request.resource.data.replies.keys().size()
               == resource.data.get('replies', {}).keys().size()
          && request.resource.data.replies.keys()
               .hasAll(resource.data.get('replies', {}).keys())
          && resource.data.get('replies', {}).keys()
               .hasAll(request.resource.data.replies.keys())
          // Keep original createdAt.
          && request.resource.data.replies[request.auth.uid].createdAt
               == resource.data.replies[request.auth.uid].createdAt;
      }

      function removingOwnReply() {
        return request.auth.uid in resource.data.get('replies', {})
          && !(request.auth.uid in request.resource.data.replies)
          && request.resource.data.replies.keys().size()
               == resource.data.get('replies', {}).keys().size() - 1
          && resource.data.get('replies', {}).keys()
               .hasAll(request.resource.data.replies.keys());
      }

      allow update: if request.auth != null
        && repliesAlive()
        && (addingOwnReply()
            || legacyAddOwnReply()
            || editingOwnReply()
            || removingOwnReply());
    }

    match /users/{uid} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys()
             .hasOnly(['uid', 'plusTrialStartedAt', 'fcmToken', 'fcmUpdatedAt', 'fcmPlatform'])
        && (!('plusTrialStartedAt' in request.resource.data)
            || request.resource.data.plusTrialStartedAt is timestamp)
        && (!('fcmToken' in request.resource.data)
            || (request.resource.data.fcmToken is string
                && request.resource.data.fcmToken.size() > 0
                && request.resource.data.fcmToken.size() < 512))
        && (!('fcmUpdatedAt' in request.resource.data)
            || request.resource.data.fcmUpdatedAt is timestamp)
        && (!('fcmPlatform' in request.resource.data)
            || (request.resource.data.fcmPlatform is string
                && request.resource.data.fcmPlatform in ['ios', 'android', 'other']));

      allow delete: if false;
    }

    match /presence/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['theme', 'uid', 'lastSeen'])
        && request.resource.data.theme in ['desert', 'forest', 'ocean', 'space']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastSeen is timestamp;

      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || (resource.data.lastSeen is timestamp
                && resource.data.lastSeen < request.time - duration.value(70, 's')));
    }
  }
}
